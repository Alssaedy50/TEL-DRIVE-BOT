{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|manifest\\.webmanifest|sw\\.js|registerSW\\.js|workbox-.*|icon\\.svg|apple-touch-icon\\.png|pwa-.*|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
